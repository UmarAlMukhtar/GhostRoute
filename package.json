{
  "name": "ghostroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-maplibre.mjs && next dev",
    "build": "node scripts/prepare-maplibre.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:acquire": "node --experimental-strip-types scripts/acquire-roads.ts",
    "data:prepare": "node --experimental-strip-types scripts/prepare-roads.ts",
    "routes:benchmark": "node --experimental-strip-types scripts/benchmark-routing.ts"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
